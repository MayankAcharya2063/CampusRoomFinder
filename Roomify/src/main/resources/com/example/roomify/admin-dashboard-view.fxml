<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="950.0"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.roomify.controller.AdminDashboardController">
    <top>
        <VBox spacing="4.0">
            <padding>
                <Insets bottom="15.0" left="25.0" right="25.0" top="20.0" />
            </padding>
            <children>
                <Label fx:id="welcomeLabel" text="Admin Dashboard" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
                <Label text="PENDING BOOKING REQUESTS" />
            </children>
        </VBox>
    </top>

    <center>
        <VBox spacing="12.0">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="15.0" />
            </padding>
            <children>
                <TableView fx:id="bookingTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="resourceColumn" prefWidth="180.0" text="Resource" />
                        <TableColumn fx:id="requesterColumn" prefWidth="150.0" text="Requester" />
                        <TableColumn fx:id="startColumn" prefWidth="170.0" text="Start" />
                        <TableColumn fx:id="endColumn" prefWidth="170.0" text="End" />
                        <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Status" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <padding>
                <Insets bottom="18.0" left="25.0" right="25.0" top="10.0" />
            </padding>
            <children>
                <Button fx:id="viewResourcesButton" onAction="#handleViewResources" text="View Resources" />
                <Button fx:id="logoutButton" onAction="#handleLogout" text="Logout" />
                <Button fx:id="rejectButton" onAction="#handleReject" text="Reject" />
                <Button fx:id="approveButton" onAction="#handleApprove" text="Approve" />
            </children>
        </HBox>
    </bottom>
</BorderPane>