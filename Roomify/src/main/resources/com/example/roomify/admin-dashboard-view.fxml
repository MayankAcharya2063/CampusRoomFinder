<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="650.0" prefWidth="950.0"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.roomify.controller.AdminDashboardController">

    <!-- Top Header Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #1E293B; -fx-padding: 15px 25px;">
            <children>
                <Label text="Roomify Admin" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="welcomeLabel" text="Welcome, Admin" style="-fx-text-fill: white;" />
                <Button fx:id="logoutButton" onAction="#handleLogout" text="Logout" />
            </children>
        </HBox>
    </top>

    <!-- Left Sidebar Navigation -->
    <left>
        <VBox spacing="10.0" style="-fx-background-color: #334155; -fx-padding: 20px 10px;" prefWidth="180.0">
            <children>
                <Button text="Dashboard" maxWidth="Infinity" />
                <Button fx:id="viewResourcesButton" onAction="#handleViewResources" text="Resources" maxWidth="Infinity" />
                <Button text="Manage Users" maxWidth="Infinity" />
            </children>
        </VBox>
    </left>

    <!-- Center Content Area -->
    <center>
        <VBox spacing="12.0">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="15.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Pending Approval Requests" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="pendingCountLabel" text="Pending: 0" style="-fx-font-weight: bold;" />
                    </children>
                </HBox>

                <TableView fx:id="bookingTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="resourceColumn" prefWidth="180.0" text="Resource" />
                        <TableColumn fx:id="requesterColumn" prefWidth="150.0" text="Requester" />
                        <TableColumn fx:id="startColumn" prefWidth="180.0" text="Start Time" />
                        <TableColumn fx:id="endColumn" prefWidth="180.0" text="End Time" />
                        <TableColumn fx:id="statusColumn" prefWidth="110.0" text="Status" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>

    <!-- Bottom Action Bar -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <padding>
                <Insets bottom="18.0" left="25.0" right="25.0" top="10.0" />
            </padding>
            <children>
                <Label fx:id="statusLabel" text="Ready" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="refreshButton" onAction="#handleRefresh" text="Refresh" />
                <Button fx:id="rejectButton" onAction="#handleReject" text="Reject" style="-fx-background-color: #EF4444; -fx-text-fill: white;" />
                <Button fx:id="approveButton" onAction="#handleApprove" text="Approve" style="-fx-background-color: #10B981; -fx-text-fill: white;" />
            </children>
        </HBox>
    </bottom>
</BorderPane>