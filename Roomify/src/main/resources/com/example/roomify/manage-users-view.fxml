<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.roomify.controller.ManageUserController">

    <children>
        <!-- Header -->
        <VBox spacing="4.0">
            <children>
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Manage Users" />
                <Label style="-fx-text-fill: #64748B;" text="Add, edit, and manage system users." />
            </children>
        </VBox>

        <!-- Search Bar -->
        <HBox spacing="12.0">
            <children>
                <TextField fx:id="searchField" promptText="Search users by name, email, or role..." HBox.hgrow="ALWAYS" />
                <Button onAction="#handleSearch" styleClass="btn-secondary" text="🔍 Search" />
                <Button onAction="#handleClearSearch" styleClass="btn-secondary" text="Clear" />
            </children>
        </HBox>

        <!-- User Table -->
        <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="userIdColumn" prefWidth="80.0" text="ID" />
                <TableColumn fx:id="nameColumn" prefWidth="180.0" text="Name" />
                <TableColumn fx:id="emailColumn" prefWidth="200.0" text="Email" />
                <TableColumn fx:id="roleColumn" prefWidth="100.0" text="Role" />
                <TableColumn fx:id="departmentColumn" prefWidth="150.0" text="Department" />
            </columns>
        </TableView>

        <!-- Form -->
        <VBox spacing="8.0" styleClass="form-panel">
            <children>
                <Label style="-fx-font-weight: bold; -fx-text-fill: #1E293B;" text="User Details" />
                <HBox spacing="12.0">
                    <children>
                        <TextField fx:id="userIdField" promptText="User ID" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="nameField" promptText="Full Name" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="emailField" promptText="Email" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox spacing="12.0">
                    <children>
                        <ComboBox fx:id="roleComboBox" promptText="Role" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="departmentField" promptText="Department" HBox.hgrow="ALWAYS" />
                        <PasswordField fx:id="passwordField" promptText="Password (Min 6 chars, 1 letter &amp; 1 number)" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox spacing="12.0">
                    <children>
                        <Button onAction="#handleAdd" styleClass="btn-primary" text="➕ Add" />
                        <Button onAction="#handleEdit" styleClass="btn-primary" text="✏️ Edit" />
                        <Button onAction="#handleDelete" styleClass="btn-danger" text="🗑️ Delete" />
                        <Button onAction="#handleResetPassword" styleClass="btn-warning" text="🔑 Reset Password" />
                        <Button onAction="#handleClearFields" styleClass="btn-secondary" text="Clear Fields" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
            </padding>
        </VBox>
    </children>

    <padding>
        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
    </padding>

</VBox>