<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.roomify.controller.SearchResourcesController">

    <children>
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Label styleClass="label-title" text="🔍 Search Resources" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="refreshButton" styleClass="btn-secondary" onAction="#handleRefresh" text="🔄 Refresh" />
            </children>
        </HBox>

        <!-- Search Filters -->
        <VBox styleClass="form-panel" spacing="12.0">
            <children>
                <Label styleClass="form-label" text="Search Filters" />

                <HBox spacing="12.0">
                    <children>
                        <TextField fx:id="searchField" promptText="Search by name, ID, or type..." HBox.hgrow="ALWAYS" />
                        <Button styleClass="btn-primary" onAction="#handleSearch" text="🔍 Search" />
                        <Button styleClass="btn-secondary" onAction="#handleClearFilters" text="Clear" />
                    </children>
                </HBox>

                <HBox spacing="12.0">
                    <children>
                        <ComboBox fx:id="typeFilter" promptText="Type" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="locationFilter" promptText="Location" HBox.hgrow="ALWAYS" />
                        <CheckBox fx:id="availableOnlyCheck" text="Show available only" onAction="#handleSearch" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Resource Table -->
        <TableView fx:id="resourceTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="resourceIdColumn" prefWidth="100.0" text="Resource ID" />
                <TableColumn fx:id="nameColumn" prefWidth="180.0" text="Name" />
                <TableColumn fx:id="typeColumn" prefWidth="150.0" text="Type" />
                <TableColumn fx:id="locationColumn" prefWidth="150.0" text="Location" />
                <TableColumn fx:id="capacityColumn" prefWidth="80.0" text="Capacity" />
                <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Availability" />
            </columns>
        </TableView>

        <!-- Actions -->
        <HBox spacing="12.0" alignment="CENTER_RIGHT">
            <children>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="bookButton" styleClass="btn-book" onAction="#handleBookResource" text="📖 Book Selected Resource" disable="true" />
            </children>
        </HBox>
    </children>

    <padding>
        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
    </padding>
</VBox>