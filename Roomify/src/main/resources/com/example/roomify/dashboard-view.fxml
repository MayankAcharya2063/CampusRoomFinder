<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0"
      style="-fx-background-color: #FFF5F8;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.roomify.controller.DashboardController">

    <children>
        <!-- Welcome Section -->
        <VBox spacing="4.0">
            <children>
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #880E4F;" text="Dashboard" />
                <Label style="-fx-text-fill: #AD1457;" text="Welcome back! Here's an overview of your campus resources." />
            </children>
        </VBox>

        <!-- Stats Cards -->
        <GridPane hgap="20.0" vgap="20.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="25.0" />
                <ColumnConstraints percentWidth="25.0" />
                <ColumnConstraints percentWidth="25.0" />
                <ColumnConstraints percentWidth="25.0" />
            </columnConstraints>
            <children>
                <!-- Card 1: Total Resources -->
                <VBox styleClass="stat-card" style="-fx-padding: 20;" spacing="8.0" GridPane.columnIndex="0">
                    <children>
                        <Label styleClass="stat-icon" text="📚" />
                        <Label styleClass="stat-value" fx:id="totalResourcesLabel" text="0" />
                        <Label styleClass="stat-label" text="Total Resources" />
                    </children>
                </VBox>

                <!-- Card 2: Total Users -->
                <VBox styleClass="stat-card" style="-fx-padding: 20;" spacing="8.0" GridPane.columnIndex="1">
                    <children>
                        <Label styleClass="stat-icon" text="👥" />
                        <Label styleClass="stat-value" fx:id="totalUsersLabel" text="0" />
                        <Label styleClass="stat-label" text="Total Users" />
                    </children>
                </VBox>

                <!-- Card 3: Pending Bookings -->
                <VBox styleClass="stat-card" style="-fx-padding: 20;" spacing="8.0" GridPane.columnIndex="2">
                    <children>
                        <Label styleClass="stat-icon" text="⏳" />
                        <Label styleClass="stat-value" fx:id="pendingBookingsLabel" text="0" />
                        <Label styleClass="stat-label" text="Pending Bookings" />
                    </children>
                </VBox>

                <!-- Card 4: Today's Bookings -->
                <VBox styleClass="stat-card" style="-fx-padding: 20;" spacing="8.0" GridPane.columnIndex="3">
                    <children>
                        <Label styleClass="stat-icon" text="📅" />
                        <Label styleClass="stat-value" fx:id="todayBookingsLabel" text="0" />
                        <Label styleClass="stat-label" text="Today's Bookings" />
                    </children>
                </VBox>
            </children>
        </GridPane>

        <!-- Recent Activities -->
        <VBox spacing="12.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #880E4F;" text="Recent Activities" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleRefresh" styleClass="btn-secondary" text="🔄 Refresh" />
                    </children>
                </HBox>
                <TableView fx:id="recentActivitiesTable"
                           styleClass="table-view"
                           VBox.vgrow="ALWAYS" prefHeight="200.0">
                    <columns>
                        <TableColumn fx:id="timestampColumn" prefWidth="200.0" text="Timestamp" />
                        <TableColumn fx:id="actionColumn" prefWidth="250.0" text="Action" />
                        <TableColumn fx:id="userColumn" prefWidth="200.0" text="User" />
                        <TableColumn fx:id="descriptionColumn" prefWidth="350.0" text="Description" />
                    </columns>
                </TableView>
            </children>
        </VBox>

        <!-- Quick Actions -->
        <HBox spacing="12.0">
            <children>
                <Button onAction="#handleQuickAddResource" styleClass="btn-primary" text="➕ Add Resource" />
                <Button onAction="#handleQuickAddUser" styleClass="btn-primary" text="➕ Add User" />
                <Button onAction="#handleQuickViewApprovals" styleClass="btn-warning" text="📋 View Pending Approvals" />
            </children>
        </HBox>
    </children>

    <padding>
        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
    </padding>

</VBox>