<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.roomify.controller.DashboardController">

    <children>
        <!-- Stats Cards Row -->
        <HBox spacing="16.0">
            <children>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="stat-icon" text="📦" />
                        <Label fx:id="availableResourcesLabel" styleClass="stat-value" text="0" />
                        <Label styleClass="stat-label" text="Available Resources" />
                    </children>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="stat-icon" text="⏳" />
                        <Label fx:id="pendingBookingsLabel" styleClass="stat-value" text="0" />
                        <Label styleClass="stat-label" text="Pending Bookings" />
                    </children>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="stat-icon" text="✅" />
                        <Label fx:id="approvedBookingsLabel" styleClass="stat-value" text="0" />
                        <Label styleClass="stat-label" text="Approved Bookings" />
                    </children>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="stat-icon" text="❌" />
                        <Label fx:id="rejectedBookingsLabel" styleClass="stat-value" text="0" />
                        <Label styleClass="stat-label" text="Rejected Bookings" />
                    </children>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="stat-icon" text="📅" />
                        <Label fx:id="todayBookingsLabel" styleClass="stat-value" text="0" />
                        <Label styleClass="stat-label" text="Today's Bookings" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Recent Bookings -->
        <VBox styleClass="card" spacing="12.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label styleClass="card-title" text="📋 Recent Bookings" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="refreshButton" styleClass="btn-secondary" onAction="#handleRefresh" text="🔄 Refresh" />
                    </children>
                </HBox>

                <TableView fx:id="recentBookingsTable" VBox.vgrow="ALWAYS" prefHeight="200.0">
                    <columns>
                        <TableColumn fx:id="resourceColumn" prefWidth="180.0" text="Resource" />
                        <TableColumn fx:id="dateColumn" prefWidth="120.0" text="Date" />
                        <TableColumn fx:id="startColumn" prefWidth="100.0" text="Start" />
                        <TableColumn fx:id="endColumn" prefWidth="100.0" text="End" />
                        <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Status" />
                    </columns>
                </TableView>
            </children>
        </VBox>

        <!-- Quick Actions -->
        <HBox spacing="12.0">
            <children>
                <Button fx:id="searchResourcesBtn" styleClass="btn-primary" onAction="#handleSearchResources" text="🔍 Search Resources" />
                <Button fx:id="myBookingsBtn" styleClass="btn-secondary" onAction="#handleMyBookings" text="📋 My Bookings" />
                <Region HBox.hgrow="ALWAYS" />
                <Label style="-fx-text-fill: #5D2E46; -fx-font-size: 12px;" text="Need help? Contact support" />
            </children>
        </HBox>
    </children>

    <padding>
        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
    </padding>
</VBox>