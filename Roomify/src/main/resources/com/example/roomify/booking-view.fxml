<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="10.0" prefWidth="480.0"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.roomify.controller.BookingController">
    <padding>
        <Insets bottom="30.0" left="35.0" right="35.0" top="30.0" />
    </padding>
    <children>
        <Label text="New Booking" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        <Label fx:id="resourceNameLabel" text="Resource" />
        <Label fx:id="capacityLabel" text="Capacity" />

        <VBox spacing="6.0">
            <VBox.margin>
                <Insets top="15.0" />
            </VBox.margin>
            <children>
                <Label text="Date" />
                <DatePicker fx:id="datePicker" maxWidth="Infinity" />
            </children>
        </VBox>

        <HBox spacing="12.0">
            <VBox.margin>
                <Insets top="8.0" />
            </VBox.margin>
            <children>
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Start Hour" />
                        <ComboBox fx:id="startHourCombo" maxWidth="Infinity" />
                    </children>
                </VBox>
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Duration (hrs)" />
                        <ComboBox fx:id="durationCombo" maxWidth="Infinity" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <VBox spacing="6.0">
            <VBox.margin>
                <Insets top="8.0" />
            </VBox.margin>
            <children>
                <Label text="Purpose" />
                <TextArea fx:id="purposeField" prefRowCount="3" wrapText="true" />
            </children>
        </VBox>

        <HBox alignment="CENTER" spacing="12.0">
            <VBox.margin>
                <Insets top="18.0" />
            </VBox.margin>
            <children>
                <Button fx:id="cancelButton" onAction="#handleCancel" text="Cancel" />
                <Button fx:id="confirmButton" maxWidth="Infinity" onAction="#handleConfirmBooking"
                        text="Confirm Booking" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
    </children>
</VBox>