<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" styleClass="root-pane"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.roomify.controller.ManageResourceController">

    <children>
        <!-- Header -->
        <VBox spacing="4.0">
            <children>
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Manage Resources" />
                <Label style="-fx-text-fill: #64748B;" text="Add, edit, and manage campus resources." />
            </children>
        </VBox>

        <!-- Search Bar -->
        <HBox spacing="12.0">
            <children>
                <TextField fx:id="searchField" promptText="Search resources by name, type, or location..." HBox.hgrow="ALWAYS" />
                <Button onAction="#handleSearch" styleClass="btn-secondary" text="🔍 Search" />
                <Button onAction="#handleClearSearch" styleClass="btn-secondary" text="Clear" />
            </children>
        </HBox>

        <!-- Resource Table -->
        <TableView fx:id="resourceTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="resourceIdColumn" prefWidth="100.0" text="ID" />
                <TableColumn fx:id="nameColumn" prefWidth="180.0" text="Name" />
                <TableColumn fx:id="typeColumn" prefWidth="120.0" text="Type" />
                <TableColumn fx:id="locationColumn" prefWidth="150.0" text="Location" />
                <TableColumn fx:id="capacityColumn" prefWidth="80.0" text="Capacity" />
                <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Status" />
            </columns>
        </TableView>

        <!-- Form -->
        <VBox spacing="8.0" styleClass="form-panel">
            <children>
                <Label style="-fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Resource Details" />
                <HBox spacing="12.0">
                    <children>
                        <TextField fx:id="resourceIdField" promptText="Resource ID (e.g., RES-001)" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="nameField" promptText="Resource Name" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="typeComboBox" promptText="Type" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox spacing="12.0">
                    <children>
                        <TextField fx:id="locationField" promptText="Location" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="capacityField" promptText="Capacity" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="statusComboBox" promptText="Status" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox spacing="12.0">
                    <children>
                        <Button onAction="#handleAdd" styleClass="btn-primary" text="➕ Add" />
                        <Button onAction="#handleEdit" styleClass="btn-primary" text="✏️ Edit" />
                        <Button onAction="#handleDelete" styleClass="btn-danger" text="🗑️ Delete" />
                        <Button onAction="#handleClearFields" styleClass="btn-secondary" text="Clear Fields" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
            </padding>
        </VBox>
    </children>

    <padding>
        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
    </padding>

</VBox>