<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="500.0" prefWidth="700.0"
           styleClass="root-pane-login"
           stylesheets="@styles.css"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.roomify.controller.LoginController">
   <children>
      <VBox alignment="CENTER" maxHeight="500.0" maxWidth="420.0" spacing="10.0" styleClass="login-card">
         <children>
            <Label styleClass="title-label" text="Welcome to Roomify!" />
            <Label styleClass="subtitle-label" text="CAMPUS RESOURCES AND STUDY SPACE BOOKING SYSTEM" textAlignment="CENTER" wrapText="true" />

            <VBox alignment="CENTER_LEFT" spacing="6.0">
               <VBox.margin>
                  <Insets top="15.0" />
               </VBox.margin>
               <children>
                  <Label styleClass="field-label" text="Username" />
                  <TextField fx:id="emailField" promptText="abc@roomify.com" styleClass="input-field" />

                  <Label styleClass="field-label" text="Password">
                     <VBox.margin>
                        <Insets top="8.0" />
                     </VBox.margin>
                  </Label>
                  <PasswordField fx:id="passwordField" promptText="*****" styleClass="input-field" />

                  <Button fx:id="loginButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLoginSubmit" styleClass="login-button" text="Login">
                     <VBox.margin>
                        <Insets top="18.0" />
                     </VBox.margin>
                  </Button>
               </children>
            </VBox>
             <!-- Demo Credentials hint -->
             <VBox spacing="5.0"
                   style="-fx-background-color:#FFF0F5; -fx-background-radius:8; -fx-border-color:#F8BBD0; -fx-border-radius:8; -fx-padding:10 14 10 14;">
                <VBox.margin><Insets top="6.0" /></VBox.margin>
                <children>
                   <Label text="🔑  Demo Credentials"
                          style="-fx-font-size:11px; -fx-font-weight:bold; -fx-text-fill:#880E4F;" />
                   <Label text="Admin    │  admin@roomify.com   /  admin123"
                          style="-fx-font-size:11px; -fx-text-fill:#AD1457; -fx-font-family:'Courier New';" />
                   <Label text="Staff     │  staff@roomify.com    /  staff123"
                          style="-fx-font-size:11px; -fx-text-fill:#AD1457; -fx-font-family:'Courier New';" />
                   <Label text="Student │  student@roomify.com  /  student123"
                          style="-fx-font-size:11px; -fx-text-fill:#AD1457; -fx-font-family:'Courier New';" />
                </children>
             </VBox>
          </children>
          <padding>
             <Insets bottom="30.0" left="35.0" right="35.0" top="30.0" />
          </padding>
       </VBox>

    </children>
</StackPane>