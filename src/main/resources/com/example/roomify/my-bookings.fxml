<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.roomify.controller.MyBookingsController">

    <children>
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Label styleClass="label-title" text="📋 My Bookings" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="refreshButton" styleClass="btn-secondary" onAction="#handleRefresh" text="🔄 Refresh" />
            </children>
        </HBox>

        <!-- Filters -->
        <HBox spacing="12.0">
            <children>
                <TextField fx:id="searchField" promptText="Search by ID or resource..." HBox.hgrow="ALWAYS" onAction="#handleSearch" />
                <ComboBox fx:id="statusFilter" promptText="Status" prefWidth="150.0" />
                <Button styleClass="btn-secondary" onAction="#handleClearFilters" text="Clear Filters" />
            </children>
        </HBox>

        <!-- Bookings Table -->
        <TableView fx:id="bookingsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="bookingIdColumn" prefWidth="100.0" text="Booking ID" />
                <TableColumn fx:id="resourceColumn" prefWidth="180.0" text="Resource" />
                <TableColumn fx:id="dateColumn" prefWidth="120.0" text="Date" />
                <TableColumn fx:id="startColumn" prefWidth="100.0" text="Start" />
                <TableColumn fx:id="endColumn" prefWidth="100.0" text="End" />
                <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Status" />
                <TableColumn fx:id="createdDateColumn" prefWidth="150.0" text="Created Date" />
            </columns>
        </TableView>

        <!-- Actions -->
        <HBox spacing="12.0" alignment="CENTER_RIGHT">
            <children>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="cancelButton" styleClass="btn-danger" onAction="#handleCancelBooking" text="🗑️ Cancel Selected Booking" />
            </children>
        </HBox>
    </children>

    <padding>
        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
    </padding>
</VBox>
